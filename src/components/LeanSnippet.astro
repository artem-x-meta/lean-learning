---
/**
 * Кусок настоящего Lean-файла из каталога lean/.
 *
 * Код не дублируется в разметке: компонент читает его из файла на сборке.
 * Значит, в курсе не может оказаться примера, который не компилируется —
 * эти же файлы проверяет `lake build` в CI.
 *
 * Границы куска размечаются комментариями в самом .lean-файле:
 *
 *   -- BEGIN: first-proof
 *   theorem my_first : 2 + 2 = 4 := rfl
 *   -- END: first-proof
 *
 * Маркеры в сниппет не попадают.
 */
import { langFromPath, t } from '../lib/i18n';
import { readLeanFile, extractRegion, extractImports, playgroundUrl } from '../lib/leanRegions';
import LeanRunner from './LeanRunner';

interface Props {
  /** Путь внутри каталога lean/, например 'DiveLean/Ch01/Basics.lean'. */
  file: string;
  /** Имя размеченного куска. Без него берётся весь файл, кроме импортов. */
  region?: string;
  /** Подпись над кодом. */
  title?: string;
  /** Показывать кнопку «открыть в песочнице». */
  playground?: boolean;
}

const { file, region, title, playground = true } = Astro.props;
const lang = langFromPath(Astro.url.pathname);

const source = readLeanFile(file);
const code = region ? extractRegion(source, region, file) : source.trim();

// Песочнице нужны импорты: внутри куска их обычно нет, берём из шапки файла.
const imports = extractImports(source);
const playgroundCode = imports && !code.startsWith('import') ? `${imports}\n\n${code}` : code;
const url = playgroundUrl(playgroundCode);
---

<figure class="dm-lean-snippet not-content">
  {title && <figcaption class="dm-lean-snippet__title">{title}</figcaption>}
  <pre class="dm-lean-snippet__code"><code>{code}</code></pre>
  {/* Appears only when the local checker from `npm run lean` answers. */}
  <LeanRunner client:visible code={playgroundCode} lang={lang} />

  {playground && (
    <a class="dm-lean-snippet__playground" href={url} target="_blank" rel="noopener">
      {t(lang, 'playground')} <span aria-hidden="true">↗</span>
    </a>
  )}
</figure>
