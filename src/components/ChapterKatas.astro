---
/**
 * The katas a chapter has earned you, listed where the chapter ends.
 *
 * The catalogue is one page in the sidebar, which is easy to read past. This
 * puts the exercises at the moment they become solvable — and renders nothing
 * for a chapter that has none yet, so it can be dropped into every chapter
 * without deciding first which ones are covered.
 */
import { katas } from '../data/katas';
import { withBase } from '../lib/basePath';
import { langFromPath, t } from '../lib/i18n';

interface Props {
  /** Chapter slug, as in the kata catalogue. */
  chapter: string;
}

const { chapter } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const mine = katas.filter((kata) => kata.chapter === chapter);
const prefix = lang === 'ru' ? '/ru' : '';
---

{mine.length > 0 && (
  <aside class="dm-chapter-katas not-content">
    <p class="dm-chapter-katas__title">{t(lang, 'chapterKatasTitle')}</p>
    <p class="dm-chapter-katas__hint">{t(lang, 'chapterKatasHint')}</p>
    <ul class="dm-chapter-katas__list">
      {mine.map((kata) => (
        <li>
          <a href={withBase(`${prefix}/practice/${kata.slug}/`)}>{kata.title[lang]}</a>
        </li>
      ))}
    </ul>
  </aside>
)}
